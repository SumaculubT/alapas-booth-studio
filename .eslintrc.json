{
  "root": true,
  "ignorePatterns": [".next", "node_modules", "e2e", "playwright-report", "test-results"],
  "overrides": [
    {
      "files": ["src/**/*.{ts,tsx}"],
      "parser": "@typescript-eslint/parser",
      "parserOptions": {
        "ecmaVersion": 2022,
        "sourceType": "module",
        "ecmaFeatures": { "jsx": true }
      },
      "plugins": ["@typescript-eslint"],
      "rules": {
        "no-unused-vars": "off",
        "@typescript-eslint/no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }]
      }
    }
  ]
}
